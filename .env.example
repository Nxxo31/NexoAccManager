# NexoAccManager Environment Variables
# Copy to .env (NEVER commit .env — it's gitignored) and fill in your values.

# Optional: override Discord Rich Presence client ID.
# Default (placeholder app): 1274925610645274655 — replace with your own Discord app ID
# from https://discord.com/developers/applications. Leave unset to use the placeholder.
# DISCORD_CLIENT_ID=

# App metadata (optional — falls back to package.json)
# NAM_APP_NAME="NX-Manager"
# NAM_APP_VERSION=

# Browser-only mode: when set to 1, the renderer runs in a plain Vite dev server
# without Electron. Useful for UI development without an Electron binary.
# BROWSER_ONLY=1

# Where local data lives. Defaults to Electron's app.getPath('userData').
# NAM_DATA_DIR=

# Where backups are stored when no custom folder is configured.
# Defaults to <userData>/backups.
# NAM_BACKUP_DIR=

# Local API server port (Settings → Web Server).
# Defaults to 4153.
# NAM_LOCAL_API_PORT=4153

# Log level: error | warn | info | debug
# Defaults to info.
# NAM_LOG_LEVEL=info

# When 1, allows NAM to launch even if signed binary verification fails.
# Disable in production.
# NAM_ALLOW_UNSIGNED=0
