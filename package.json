{
  "name": "nx-manager",
  "version": "4.1.0",
  "description": "Open-source multi-account manager for gaming platforms — 100% local, no servers, no cloud",
  "main": "dist/main/main.js",
  "author": {
    "name": "NexoAccManager Contributors",
    "email": "nexoaccmanager@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:browser": "BROWSER_ONLY=1 vite",
    "build": "tsc && vite build && electron-builder",
    "electron:dev": "vite-plugin-electron dev",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "electron-builder --dir",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern '*.config.*' --ignore-pattern 'public/**' --ignore-pattern 'dist/**'"
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/form": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/modals": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "axios": "^1.6.0",
    "better-sqlite3": "^9.4.0",
    "bufferutil": "^4.1.0",
    "discord-rpc": "^4.0.1",
    "electron-store": "^11.0.2",
    "i18next": "^26.3.1",
    "node-forge": "^1.3.1",
    "react-i18next": "^17.0.8",
    "utf-8-validate": "^5.0.10",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@deslint/eslint-plugin": "^0.10.0",
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-dialog": "^1.1.19",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/discord-rpc": "^4.0.11",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^10.5.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "postcss": "^8.5.21",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.15.6",
    "wait-on": "^7.2.0",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.nxmanager.app",
    "productName": "NX-Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "asarUnpack": [
        "node_modules/better-sqlite3/**",
        "node_modules/electron-store/**"
      ],
      "sign": "build/windows-sign.js",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NX-Manager"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true
    }
  }
}
